APP_PATH=/path/to/your/app
BACKUP_PATH=/path/to/backups
LOG_PATH=/path/to/logs
DB_PATH=/path/to/database.sqlite
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=gallformers
EMAIL_TO=
PRIMARY_DOMAIN=gallformers.org
SECONDARY_DOMAIN=gallformers.com
SSL_CERT_PATH=/etc/letsencrypt/live/gallformers.org/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/gallformers.org/privkey.pem
NGINX_CONF_PATH=/etc/nginx/sites-available/gallformers
BACKUP_LOCAL_RETENTION_DAYS=7
BACKUP_S3_RETENTION_DAYS=100
BACKUP_SCHEDULE=0 2 * * *
BACKUP_MONITOR_SCHEDULE=0 */6 * * *
PM2_APP_NAME=gallformers
PM2_MAX_MEMORY=1G
PM2_RESTART_DELAY=4000
PM2_MAX_RESTARTS=10
PM2_MIN_UPTIME=5s
PM2_LISTEN_TIMEOUT=8000
PM2_KILL_TIMEOUT=2000
LOG_ROTATE_DAYS=14
LOG_ROTATE_PATH=/etc/logrotate.d/gallformers
NODE_ENV=development
NODE_VERSION=20.x
DATABASE_URL=file:/path/to/database.sqlite
AUTH0_SECRET=
AUTH0_BASE_URL=https://gallformers.org
AUTH0_ISSUER_BASE_URL=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=
DEPLOY_BRANCH=main
DEPLOY_REMOTE=origin
DEPLOY_SCRIPT_PATH=/path/to/deploy/script
MONITOR_EMAIL=
PYTHON_VERSION=3.8
BUILD_ESSENTIAL=yes
LIBVIPS_DEV=yes
LIBSQLITE3_DEV=yes
MAILUTILS=yes
AWS_CLI=yes
GIT=yes
NGINX=yes
CERTBOT=yes 
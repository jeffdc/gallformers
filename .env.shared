# Application Paths
APP_PATH=/path/to/your/app
BACKUP_PATH=/path/to/backups
LOG_PATH=/path/to/logs
DB_PATH=/path/to/database.sqlite

# AWS Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# Email Configuration
EMAIL_TO=

# Domain Configuration
PRIMARY_DOMAIN=gallformers.org
SECONDARY_DOMAIN=gallformers.com

# SSL Configuration
SSL_CERT_PATH=/etc/letsencrypt/live/gallformers.org/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/gallformers.org/privkey.pem

# Nginx Configuration
NGINX_CONF_PATH=/etc/nginx/sites-available/gallformers

# Backup Configuration
BACKUP_RETENTION_DAYS=14
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_MONITOR_SCHEDULE="0 */6 * * *"  # Every 6 hours

# PM2 Configuration
PM2_APP_NAME=gallformers
PM2_MAX_MEMORY=1G
PM2_RESTART_DELAY=4000
PM2_MAX_RESTARTS=10
PM2_MIN_UPTIME=5s
PM2_LISTEN_TIMEOUT=8000
PM2_KILL_TIMEOUT=2000

# Log Rotation Configuration
LOG_ROTATE_DAYS=14
LOG_ROTATE_PATH=/etc/logrotate.d/gallformers

# Node.js Configuration
NODE_ENV=development
NODE_VERSION=20.x

# Database Configuration
DATABASE_URL=file:/path/to/database.sqlite

# Auth0 Configuration
AUTH0_SECRET=
AUTH0_BASE_URL=https://gallformers.org
AUTH0_ISSUER_BASE_URL=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=

# Deployment Configuration
DEPLOY_BRANCH=main
DEPLOY_REMOTE=origin
DEPLOY_SCRIPT_PATH=/path/to/deploy/script

# Monitoring Configuration
MONITOR_EMAIL=

# System Dependencies
PYTHON_VERSION=3.8
BUILD_ESSENTIAL=yes
LIBVIPS_DEV=yes
LIBSQLITE3_DEV=yes
MAILUTILS=yes
AWS_CLI=yes
GIT=yes
NGINX=yes
CERTBOT=yes 
# Application paths
APP_PATH=/var/www/gallformers
BACKUP_PATH=/var/backups/gallformers
LOG_PATH=/var/log/gallformers
DB_PATH=/var/lib/gallformers/gallformers.sqlite

# AWS Configuration
# Note: These should be set via environment variables or AWS IAM roles in production
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=gallformers-prod

# Email Configuration
EMAIL_TO=admin@gallformers.org

# Backup Configuration
BACKUP_RETENTION_DAYS=30

# PM2 Configuration
PM2_MAX_MEMORY=2G
PM2_RESTART_DELAY=5000
PM2_MAX_RESTARTS=5

# Node.js Configuration
NODE_ENV=production

# Database Configuration
DATABASE_URL=file:$DB_PATH 
# Application paths
APP_PATH=$HOME/dev/gallformers
BACKUP_PATH=$APP_PATH/backups
LOG_PATH=$APP_PATH/logs
DB_PATH=$APP_PATH/gallformers.sqlite

# AWS Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=gallformers-dev

# Email Configuration
EMAIL_TO=dev@gallformers.org

# Backup Configuration
BACKUP_RETENTION_DAYS=7

# PM2 Configuration
PM2_MAX_MEMORY=1G
PM2_RESTART_DELAY=2000
PM2_MAX_RESTARTS=20

# Node.js Configuration
NODE_ENV=development

# Database Configuration
DATABASE_URL=file:$DB_PATH 
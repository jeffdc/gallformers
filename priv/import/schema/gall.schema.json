{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gallformers.org/schemas/import/v3/schema/gall.schema.json",
  "title": "Gallformers import — gall batch",
  "description": "What a Source states about Galls: Relationships (including Hosts and Inducers), qualifiers, Traits, range adjustments, recorded occurrences, common names, and descriptions (quotes). Taxonomic acts go in the taxonomy batch.",
  "type": "object",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "description": "Format 3 trait Facts carry value + as_written; format 4 trait Facts carry the Source's term and a suggested category, and its unmapped entries take no Trait slot.",
      "if": { "properties": { "format_version": { "const": 3 } }, "required": ["format_version"] },
      "then": { "properties": { "facts": { "items": { "$ref": "#/$defs/fact_v3" } } } },
      "else": {
        "properties": {
          "facts": { "items": { "$ref": "#/$defs/fact" } },
          "unmapped": {
            "items": {
              "properties": {
                "slot": {
                  "description": "A Trait term is a trait Fact (category null when no value fits), never an unmapped entry.",
                  "enum": ["generation", "relationship_type", "lethality", "parasitism_mode", "place", "rank", "taxonomic_act", "other"]
                }
              }
            }
          }
        }
      }
    }
  ],
  "required": ["batch_type", "taxa", "galls", "facts"],
  "properties": {
    "format": true, "format_version": true, "vocabulary_version": true, "mode": true,
    "batch_id": true, "produced_at": true, "producer": true, "source": true,
    "batch_type": { "const": "gall" },
    "taxa": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/taxon_ref" },
      "description": "Every taxon the Galls and Facts mention (Inducers, Hosts, other organisms), declared once."
    },
    "galls": {
      "type": "array",
      "items": { "$ref": "#/$defs/gall_ref" },
      "description": "Every Gall the Facts mention, declared once."
    },
    "facts": {
      "type": "array",
      "description": "The Facts the Source states (#/$defs/fact; in format 3, #/$defs/fact_v3). Empty only on a retraction notice."
    },
    "unmapped": { "$ref": "common.schema.json#/$defs/unmapped" }
  },
  "unevaluatedProperties": false,

  "$defs": {
    "gall_ref": {
      "description": "A Gall, described by what identifies it in the Source.",
      "type": "object",
      "required": ["ref", "name_as_written", "identified_by"],
      "properties": {
        "ref": { "$ref": "common.schema.json#/$defs/gall_ref_id" },
        "name_as_written": { "type": "string", "minLength": 1, "description": "How the Source refers to the Gall (e.g. 'the agamic gall of Andricus …', 'a small spindle gall on the midrib')." },
        "identified_by": {
          "type": "object",
          "properties": {
            "inducer": { "$ref": "common.schema.json#/$defs/taxon_ref_id", "description": "The Inducer, at whatever rank the Source gives (species, or genus/family for undescribed Galls)." },
            "generation": {
              "description": "Use when the Source shows a clearly different Gall for this stage of the Inducer's life cycle; repeated broods that induce the same Gall are one Gall. The value comes from the generation group for the Inducer's taxon (vocab/traits.json).",
              "type": "object",
              "required": ["value", "as_written"],
              "properties": {
                "value": { "$ref": "../vocab/traits.schema.json#/$defs/generation" },
                "as_written": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            },
            "host": { "$ref": "common.schema.json#/$defs/taxon_ref_id", "description": "Use when the Host distinguishes the Gall (e.g. an undescribed Gall known only from its Host)." },
            "plant_part": {
              "description": "Use when two Galls of one Inducer and Host differ by where they grow (a collar gall and a spindle gall of one Antistrophus on one plant).",
              "type": "object",
              "required": ["value", "as_written"],
              "properties": {
                "value": { "$ref": "../vocab/traits.schema.json#/$defs/plant_part" },
                "as_written": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "anyOf": [{ "required": ["inducer"] }, { "required": ["host"] }],
          "additionalProperties": false
        },
        "new": {
          "type": "boolean",
          "description": "true only when the Source presents the Gall as previously unknown — including a newly described generation of a known species. The batch must then contain at least one Fact about it."
        },
        "formerly_undescribed": {
          "type": "boolean",
          "description": "true when the Gall was known before but this Source names its Inducer for the first time (e.g. a gall reported in 1959, its wasp described in 1997). Give its Host in identified_by."
        },
        "gallformers_gall_id": { "type": "integer", "minimum": 1, "description": "Optional: Gallformers' ID for this Gall, given only when known for certain. It must match identified_by." }
      },
      "additionalProperties": false
    },

    "fact": {
      "description": "A Fact; its kind decides its fields.",
      "allOf": [
        { "$ref": "#/$defs/fact_kinds" },
        { "if": { "properties": { "kind": { "const": "trait" } } }, "then": { "$ref": "#/$defs/trait_fact" } }
      ]
    },

    "fact_v3": {
      "description": "A Fact in a format 3 batch: as in format 4, except trait Facts (#/$defs/trait_fact_v3).",
      "allOf": [
        { "$ref": "#/$defs/fact_kinds" },
        { "if": { "properties": { "kind": { "const": "trait" } } }, "then": { "$ref": "#/$defs/trait_fact_v3" } }
      ]
    },

    "fact_kinds": {
      "description": "The kinds of Fact, and the fields of each kind but trait (which differs by format).",
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["relationship", "qualifier", "trait", "range", "occurrence", "alias", "description"] }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "relationship" } } }, "then": { "$ref": "#/$defs/relationship_fact" } },
        { "if": { "properties": { "kind": { "const": "qualifier" } } }, "then": { "$ref": "#/$defs/qualifier_fact" } },
        { "if": { "properties": { "kind": { "const": "range" } } }, "then": { "$ref": "#/$defs/range_fact" } },
        { "if": { "properties": { "kind": { "const": "occurrence" } } }, "then": { "$ref": "#/$defs/occurrence_fact" } },
        { "if": { "properties": { "kind": { "const": "alias" } } }, "then": { "$ref": "#/$defs/alias_fact" } },
        { "if": { "properties": { "kind": { "const": "description" } } }, "then": { "$ref": "#/$defs/description_fact" } }
      ]
    },

    "fact_base": {
      "type": "object",
      "required": ["id", "stance", "kind", "evidence"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/fact_id" },
        "stance": { "$ref": "common.schema.json#/$defs/stance" },
        "evidence": { "$ref": "common.schema.json#/$defs/evidence" },
        "unstated": { "const": true, "description": "A reading fix only: the Source doesn't say this; its statement of the Fact is taken away." },
        "replaces": { "$ref": "common.schema.json#/$defs/fact_id", "description": "A reading fix only: the unstated Fact of this batch that this one is what the Source says in place of." }
      }
    },

    "relationship_fact": {
      "description": "A Relationship. Its type decides the endpoints: organism → Gall; Gall → Gall; or organism → organism within a Gall (gall_context). host_of takes a plant subject.",
      "allOf": [
        { "$ref": "#/$defs/fact_base" },
        {
          "if": { "properties": { "type": { "$ref": "../vocab/relationships.schema.json#/$defs/taxon_to_gall" } } },
          "then": {
            "properties": {
              "subject": { "$ref": "common.schema.json#/$defs/taxon_ref_id" },
              "object": { "$ref": "common.schema.json#/$defs/gall_ref_id" },
              "gall_context": false
            }
          }
        },
        {
          "if": { "properties": { "type": { "$ref": "../vocab/relationships.schema.json#/$defs/gall_to_gall" } } },
          "then": {
            "properties": {
              "subject": { "$ref": "common.schema.json#/$defs/gall_ref_id" },
              "object": { "$ref": "common.schema.json#/$defs/gall_ref_id" },
              "gall_context": false
            }
          }
        },
        {
          "if": { "properties": { "type": { "$ref": "../vocab/relationships.schema.json#/$defs/taxon_to_taxon_in_gall" } } },
          "then": {
            "required": ["gall_context"],
            "properties": {
              "subject": { "$ref": "common.schema.json#/$defs/taxon_ref_id" },
              "object": { "$ref": "common.schema.json#/$defs/taxon_ref_id" }
            }
          }
        }
      ],
      "required": ["type", "subject", "object"],
      "properties": {
        "kind": { "const": "relationship" },
        "type": { "$ref": "../vocab/relationships.schema.json#/$defs/type" },
        "subject": { "type": "string" },
        "object": { "type": "string" },
        "gall_context": { "$ref": "common.schema.json#/$defs/gall_ref_id" }
      },
      "unevaluatedProperties": false
    },

    "qualifier_fact": {
      "description": "A qualifier on a Relationship Fact in this batch (of = that Fact's id). Its own Fact, with its own evidence. PRODUCER_GUIDE.md lists which qualifiers fit which Relationship types.",
      "allOf": [
        { "$ref": "#/$defs/fact_base" },
        { "if": { "properties": { "qualifier": { "const": "required_for_formation" } } }, "then": { "properties": { "value": { "properties": { "value": { "const": true } } } } } },
        { "if": { "properties": { "qualifier": { "const": "lethality" } } }, "then": { "properties": { "value": { "properties": { "value": { "$ref": "../vocab/relationships.schema.json#/$defs/lethality" } } } } } },
        { "if": { "properties": { "qualifier": { "const": "parasitism_mode" } } }, "then": { "properties": { "value": { "properties": { "value": { "$ref": "../vocab/relationships.schema.json#/$defs/parasitism_mode" } } } } } }
      ],
      "required": ["of", "qualifier", "value"],
      "properties": {
        "kind": { "const": "qualifier" },
        "of": { "$ref": "common.schema.json#/$defs/fact_id" },
        "qualifier": { "enum": ["required_for_formation", "lethality", "parasitism_mode"] },
        "value": { "$ref": "#/$defs/controlled_value" }
      },
      "unevaluatedProperties": false
    },

    "trait_name": { "enum": ["detachable", "plant_part", "form", "shape", "color", "texture", "alignment", "walls", "cells", "season"] },

    "trait_fact": {
      "description": "One Source term for a Trait of a Gall, with the category (Trait value) the producer suggests for it. Gallformers decides the category on import (PRODUCER_GUIDE.md, Phase 3, Traits). One Fact per term; detachable takes one. Generation goes in galls[].identified_by: it identifies the Gall.",
      "allOf": [
        { "$ref": "#/$defs/fact_base" },
        { "$ref": "#/$defs/trait_category_for" }
      ],
      "required": ["gall", "trait", "term", "category"],
      "properties": {
        "kind": { "const": "trait" },
        "gall": { "$ref": "common.schema.json#/$defs/gall_ref_id" },
        "trait": { "$ref": "#/$defs/trait_name" },
        "term": { "type": "string", "minLength": 1, "description": "The Source's term for this Trait, verbatim: the shortest phrase that is the term (\"ovoid\", \"pale tan\", \"covered in short hairs\"). The sentence stays in the quote." },
        "category": {
          "description": "The value of this Trait the term fits by its definition (vocab/traits.json), or null when none fits.",
          "type": ["object", "null"],
          "required": ["value"],
          "properties": { "value": true },
          "additionalProperties": false
        },
        "depends_on_gall": { "const": true, "description": "The term's category depends on this Gall: the term means different values for different Galls (\"swelling\": abrupt swelling, tapered swelling or stem club)." }
      },
      "unevaluatedProperties": false
    },

    "trait_category_for": {
      "description": "The allowed categories for each trait (format 4).",
      "allOf": [
        { "if": { "properties": { "trait": { "const": "detachable" } } }, "then": { "properties": { "category": { "properties": { "value": { "$ref": "../vocab/traits.schema.json#/$defs/detachable" } } } } } },
        { "if": { "properties": { "trait": { "const": "plant_part" } } }, "then": { "properties": { "category": { "properties": { "value": { "$ref": "../vocab/traits.schema.json#/$defs/plant_part" } } } } } },
        { "if": { "properties": { "trait": { "const": "form" } } }, "then": { "properties": { "category": { "properties": { "value": { "$ref": "../vocab/traits.schema.json#/$defs/form" } } } } } },
        { "if": { "properties": { "trait": { "const": "shape" } } }, "then": { "properties": { "category": { "properties": { "value": { "$ref": "../vocab/traits.schema.json#/$defs/shape" } } } } } },
        { "if": { "properties": { "trait": { "const": "color" } } }, "then": { "properties": { "category": { "properties": { "value": { "$ref": "../vocab/traits.schema.json#/$defs/color" } } } } } },
        { "if": { "properties": { "trait": { "const": "texture" } } }, "then": { "properties": { "category": { "properties": { "value": { "$ref": "../vocab/traits.schema.json#/$defs/texture" } } } } } },
        { "if": { "properties": { "trait": { "const": "alignment" } } }, "then": { "properties": { "category": { "properties": { "value": { "$ref": "../vocab/traits.schema.json#/$defs/alignment" } } } } } },
        { "if": { "properties": { "trait": { "const": "walls" } } }, "then": { "properties": { "category": { "properties": { "value": { "$ref": "../vocab/traits.schema.json#/$defs/walls" } } } } } },
        { "if": { "properties": { "trait": { "const": "cells" } } }, "then": { "properties": { "category": { "properties": { "value": { "$ref": "../vocab/traits.schema.json#/$defs/cells" } } } } } },
        { "if": { "properties": { "trait": { "const": "season" } } }, "then": { "properties": { "category": { "properties": { "value": { "$ref": "../vocab/traits.schema.json#/$defs/season" } } } } } }
      ]
    },

    "trait_fact_v3": {
      "description": "Format 3: one Trait value of a Gall, with the Source's wording in as_written.",
      "allOf": [
        { "$ref": "#/$defs/fact_base" },
        { "$ref": "#/$defs/trait_value_for" }
      ],
      "required": ["gall", "trait", "value"],
      "properties": {
        "kind": { "const": "trait" },
        "gall": { "$ref": "common.schema.json#/$defs/gall_ref_id" },
        "trait": { "$ref": "#/$defs/trait_name" },
        "value": { "$ref": "#/$defs/controlled_value" }
      },
      "unevaluatedProperties": false
    },

    "trait_value_for": {
      "description": "The allowed values for each trait (format 3).",
      "allOf": [
        { "if": { "properties": { "trait": { "const": "detachable" } } }, "then": { "properties": { "value": { "properties": { "value": { "$ref": "../vocab/traits.schema.json#/$defs/detachable" } } } } } },
        { "if": { "properties": { "trait": { "const": "plant_part" } } }, "then": { "properties": { "value": { "properties": { "value": { "$ref": "../vocab/traits.schema.json#/$defs/plant_part" } } } } } },
        { "if": { "properties": { "trait": { "const": "form" } } }, "then": { "properties": { "value": { "properties": { "value": { "$ref": "../vocab/traits.schema.json#/$defs/form" } } } } } },
        { "if": { "properties": { "trait": { "const": "shape" } } }, "then": { "properties": { "value": { "properties": { "value": { "$ref": "../vocab/traits.schema.json#/$defs/shape" } } } } } },
        { "if": { "properties": { "trait": { "const": "color" } } }, "then": { "properties": { "value": { "properties": { "value": { "$ref": "../vocab/traits.schema.json#/$defs/color" } } } } } },
        { "if": { "properties": { "trait": { "const": "texture" } } }, "then": { "properties": { "value": { "properties": { "value": { "$ref": "../vocab/traits.schema.json#/$defs/texture" } } } } } },
        { "if": { "properties": { "trait": { "const": "alignment" } } }, "then": { "properties": { "value": { "properties": { "value": { "$ref": "../vocab/traits.schema.json#/$defs/alignment" } } } } } },
        { "if": { "properties": { "trait": { "const": "walls" } } }, "then": { "properties": { "value": { "properties": { "value": { "$ref": "../vocab/traits.schema.json#/$defs/walls" } } } } } },
        { "if": { "properties": { "trait": { "const": "cells" } } }, "then": { "properties": { "value": { "properties": { "value": { "$ref": "../vocab/traits.schema.json#/$defs/cells" } } } } } },
        { "if": { "properties": { "trait": { "const": "season" } } }, "then": { "properties": { "value": { "properties": { "value": { "$ref": "../vocab/traits.schema.json#/$defs/season" } } } } } }
      ]
    },

    "range_fact": {
      "description": "An adjustment to the Gall's range, which follows from its Hosts' native and introduced ranges. exclude: the Gall is absent from a place within its Hosts' ranges. only: it occurs only in this place (one Fact per place). A place where the Gall occurs outside all its Hosts' ranges is a recorded occurrence (occurrence_fact).",
      "allOf": [{ "$ref": "#/$defs/fact_base" }],
      "required": ["gall", "adjustment", "place"],
      "properties": {
        "kind": { "const": "range" },
        "gall": { "$ref": "common.schema.json#/$defs/gall_ref_id" },
        "adjustment": { "enum": ["exclude", "only"] },
        "place": {
          "$ref": "#/$defs/controlled_value",
          "properties": { "value": { "$ref": "../vocab/place-codes.schema.json" } }
        }
      },
      "unevaluatedProperties": false
    },

    "occurrence_fact": {
      "description": "A place where the Source states the Gall has been recorded, with when and at what stage when the Source gives them. One Fact per place, distinct from range adjustments.",
      "allOf": [{ "$ref": "#/$defs/fact_base" }],
      "required": ["gall", "place"],
      "properties": {
        "kind": { "const": "occurrence" },
        "gall": { "$ref": "common.schema.json#/$defs/gall_ref_id" },
        "place": {
          "$ref": "#/$defs/controlled_value",
          "properties": { "value": { "$ref": "../vocab/place-codes.schema.json" } }
        },
        "when_as_written": { "type": "string", "minLength": 1, "description": "When the Gall was recorded, as the Source gives it (\"July 1961\", \"late summer\")." },
        "stage_as_written": { "type": "string", "minLength": 1, "description": "The Gall's or Inducer's stage at the record, as the Source gives it (\"young\", \"mature, adults emerging\")." }
      },
      "unevaluatedProperties": false
    },

    "alias_fact": {
      "description": "A common name for the Gall. Scientific names are taxon synonyms and belong in taxonomy batches.",
      "allOf": [{ "$ref": "#/$defs/fact_base" }],
      "required": ["gall", "name"],
      "properties": {
        "kind": { "const": "alias" },
        "gall": { "$ref": "common.schema.json#/$defs/gall_ref_id" },
        "name": { "type": "string", "minLength": 1 }
      },
      "unevaluatedProperties": false
    },

    "description_fact": {
      "description": "The Source's description of a Gall: a collage of direct quotes, in reading order. The quotes in evidence are the description, in the Source's own words. At most one per Gall.",
      "allOf": [{ "$ref": "#/$defs/fact_base" }],
      "required": ["gall"],
      "properties": {
        "kind": { "const": "description" },
        "gall": { "$ref": "common.schema.json#/$defs/gall_ref_id" }
      },
      "unevaluatedProperties": false
    },

    "controlled_value": {
      "description": "A controlled value with the Source's own wording beside it.",
      "type": "object",
      "required": ["value", "as_written"],
      "properties": {
        "value": true,
        "as_written": { "type": "string", "minLength": 1, "description": "The Source's own term or phrase that was mapped to value." }
      },
      "additionalProperties": false
    }
  }
}

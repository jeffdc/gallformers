{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gallformers.org/schemas/import/v3/vocab/traits.schema.json",
  "title": "Gall Trait vocabularies",
  "description": "The allowed values of each Trait and of generation. traits.json holds their definitions, the term mappings and the generation groups.",
  "$defs": {
    "generation": {
      "description": "Every generation value, from all the groups. Choose from the group for the Inducer's taxon (traits.json, traits.generation.groups).",
      "enum": ["agamic", "sexual", "spring", "summer", "autumn", "aecial", "telial", "fundatrix", "apterae", "exules", "gallicolae", "radicicolae"]
    },
    "detachable": { "enum": ["integral", "detachable", "both", "unknown"] },
    "plant_part": {
      "enum": ["at leaf vein angles", "between leaf veins", "bud", "flower", "fruit", "leaf edge", "leaf midrib", "lower leaf", "on leaf veins", "petiole", "stem", "underground (roots+)", "upper leaf"]
    },
    "form": {
      "enum": ["abrupt swelling", "bullet", "hat", "hidden cell", "jacket", "leaf blister", "leaf curl", "leaf edge fold", "leaf edge roll", "leaf snap", "leaf spot", "modified capitulum", "oak apple", "pip", "plum", "pocket", "rust", "scale", "stem club", "tapered swelling", "wig", "witches broom"]
    },
    "shape": {
      "enum": ["cluster", "conical", "cup", "cylindrical", "globular", "hemispherical", "linear", "numerous", "rosette", "spangle/button", "sphere", "spindle", "tuft"]
    },
    "color": {
      "enum": ["black", "brown", "gray", "green", "orange", "pink", "purple", "red", "tan", "UV", "white", "yellow"]
    },
    "texture": {
      "enum": ["areola", "bumpy", "erineum", "glaucous", "hairless", "hairy", "honeydew", "leafy", "mealy", "mottled", "pubescent", "resinous dots", "ribbed", "ruptured/split", "spiky/thorny", "spotted", "stiff", "striped", "succulent", "woolly", "wrinkly"]
    },
    "alignment": { "enum": ["drooping", "erect", "integral", "leaning", "supine"] },
    "walls": {
      "enum": ["false chamber", "mycelium lining", "ostiole", "radiating-fibers", "slit", "spongy", "thick", "thin"]
    },
    "cells": { "enum": ["free-rolling", "monothalamous", "not applicable", "polythalamous"] },
    "season": { "enum": ["Spring", "Summer", "Fall", "Winter"] }
  }
}

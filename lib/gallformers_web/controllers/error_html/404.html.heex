<.error_page
  back={back_href(assigns)}
  status="404"
  title="Page Not Found"
  description="The requested page was not found on Gallformers."
  heading="This Page Was Not Found"
>
  Notably this is also not a gall, though it sure does look like one.
  <:figure>
    <a href="https://www.inaturalist.org/observations/58767231" target="_blank" rel="noreferrer">
      <img
        src="/images/scale.jpg"
        alt="A scale insect, not a gall"
        class="max-h-80 rounded-panel"
      />
    </a>
  </:figure>
  <:actions>
    <.button href="/">Go Home</.button>
    <.button href="/id">Try our ID tool</.button>
  </:actions>
</.error_page>

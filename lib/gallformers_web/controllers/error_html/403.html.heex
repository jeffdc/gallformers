<.error_page
  back={back_href(assigns)}
  status="403"
  title="Access Denied"
  description="You don't have permission to access this page."
>
  You don't have permission to access this page. If you believe this is an error, please contact
  an administrator.
  <:actions>
    <.button href="/">Go Home</.button>
  </:actions>
</.error_page>

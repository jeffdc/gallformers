<.error_page
  back={back_href(assigns)}
  status="500"
  title="Something went wrong"
  description="An error occurred on Gallformers."
>
  An unexpected error occurred. We've been notified and are working to fix it. Please try again
  later.
  <:actions>
    <.button href="/">Go Home</.button>
    <.button href="/id">Try our ID tool</.button>
  </:actions>
</.error_page>

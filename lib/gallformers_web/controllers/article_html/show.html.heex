<Layouts.app flash={@flash} current_user={@current_user}>
  <div class="flex flex-col gap-section">
    <.notice :if={@is_draft_preview} kind={:warn} title="Draft">
      Not published: only admins can see this article.
    </.notice>

    <.page_header>
      <:crumb href={~p"/articles"}>Articles</:crumb>
      <:title>{@article.title}</:title>
      <:meta label="By">{@article.author}</:meta>
      <:meta label="Published">{format_date(display_date(@article))}</:meta>
      <:meta :if={updated?(@article)} label="Updated">{format_date(@article.updated_at)}</:meta>
      <:meta :if={@article.tags != []} label="Topics">
        <span :for={{tag, i} <- Enum.with_index(@article.tags)}>
          {if i > 0, do: ", "}<.link href={~p"/articles?tag=#{tag}"}>{tag}</.link>
        </span>
      </:meta>
      <:action>
        <.button
          :if={@is_admin}
          href={~p"/admin/articles/#{@article.id}"}
          variant="ghost"
          size="sm"
          icon="ph-pencil-simple"
          title="Edit in admin"
        >
          Edit
        </.button>
      </:action>
    </.page_header>

    <div class="gf-with-rail">
      <article class="min-w-0">
        <.prose markdown={@article.content} size={:lg} class="max-w-text" />
      </article>

      <.rail :if={@related_articles != []} width={:narrow}>
        <.panel title="Related articles">
          <ul class="flex flex-col gap-2 text-ui">
            <li :for={related <- @related_articles} class="flex flex-col">
              <.link href={~p"/articles/#{related.slug}"}>{related.title}</.link>
              <span class="text-meta text-muted">{related.author}</span>
            </li>
          </ul>
        </.panel>
      </.rail>
    </div>
  </div>
</Layouts.app>

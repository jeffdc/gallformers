<Layouts.app flash={@flash} current_user={@current_user}>
  <div class="flex flex-col gap-section">
    <.page_header>
      <:title>Articles</:title>
      <:description>
        Longer pieces on gall biology, identification and the literature.
      </:description>
    </.page_header>

    <.chip_nav :if={@tags != []} label="Topics">
      <:chip href={~p"/articles"} current={is_nil(@selected_tag)}>All</:chip>
      <:chip
        :for={tag_info <- @tags}
        href={~p"/articles?tag=#{tag_info.tag}"}
        current={@selected_tag == tag_info.tag}
        count={tag_info.count}
      >
        {tag_info.tag}
      </:chip>
    </.chip_nav>

    <.empty_state
      :if={@featured == nil and @articles == []}
      title={if @selected_tag, do: "No articles about #{@selected_tag}", else: "No articles yet"}
    >
      <:action :if={@selected_tag}><.link href={~p"/articles"}>See all articles</.link></:action>
    </.empty_state>

    <.article_card
      :if={@featured}
      href={~p"/articles/#{@featured.slug}"}
      title={@featured.title}
      topic={Enum.join(@featured.tags, " · ")}
      icon={topic_look(@featured).icon}
      tone={topic_look(@featured).tone}
      meta={card_meta(@featured)}
      label="Newest"
      featured
      edit_href={@is_admin && ~p"/admin/articles/#{@featured.id}"}
    >
      {article_preview(@featured)}
    </.article_card>

    <ul :if={@articles != []} class="grid gap-block sm:grid-cols-2 xl:grid-cols-3">
      <li :for={article <- @articles}>
        <.article_card
          href={~p"/articles/#{article.slug}"}
          title={article.title}
          topic={List.first(article.tags) || "article"}
          icon={topic_look(article).icon}
          tone={topic_look(article).tone}
          meta={card_meta(article)}
          edit_href={@is_admin && ~p"/admin/articles/#{article.id}"}
          class="h-full"
        >
          {article_preview(article)}
        </.article_card>
      </li>
    </ul>

    <.section id="more-to-read" title="More to read">
      <ul class="grid gap-block sm:grid-cols-3">
        <li>
          <.link_tile href={~p"/keys"} icon="ph-tree-structure" name="Identification keys">
            {@key_count} step-by-step keys
          </.link_tile>
        </li>
        <li>
          <.link_tile href={~p"/glossary"} icon="ph-book-open" name="Glossary">
            The terms galls are described in
          </.link_tile>
        </li>
        <li>
          <.link_tile href={~p"/filterguide"} icon="ph-funnel" name="Filter guide">
            What each ID filter means
          </.link_tile>
        </li>
      </ul>
    </.section>
  </div>
</Layouts.app>

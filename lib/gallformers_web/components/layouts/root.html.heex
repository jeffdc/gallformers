<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="color-scheme" content="light dark" />
    <%!-- The saved theme (assets/js/theme.js), applied before the page paints. --%>
    <script id="theme-init" nonce={assigns[:csp_nonce]}>
      (function () {
        var r = document.documentElement, t = null;
        try { t = localStorage.getItem("gf-theme"); } catch (e) {}
        if (t === "light" || t === "dark") r.setAttribute("data-theme", t);
        r.setAttribute("data-theme-choice", t === "light" || t === "dark" ? t : "system");
      })();
    </script>

    <%!-- SEO Meta Tags --%>
    <GallformersWeb.SEO.meta_tags
      title={assigns[:page_title]}
      description={assigns[:page_description]}
      canonical={assigns[:page_url]}
      noindex={assigns[:page_noindex] || false}
    />

    <%!-- Open Graph & Twitter Card Meta Tags --%>
    <GallformersWeb.SEO.og_tags
      title={assigns[:page_title]}
      description={assigns[:page_description]}
      url={assigns[:page_url]}
      image={assigns[:page_image]}
      type={assigns[:page_type] || "website"}
    />

    <.live_title default="Gallformers">
      {assigns[:page_title]}
    </.live_title>

    <%!-- JSON-LD Structured Data (passed from LiveViews) --%>
    <script :if={assigns[:page_json_ld]} type="application/ld+json" nonce={assigns[:csp_nonce]}>
      {Phoenix.HTML.raw(assigns[:page_json_ld])}
    </script>

    <link rel="icon" href={~p"/favicon.ico"} />
    <link rel="apple-touch-icon" href={~p"/apple-touch-icon.png"} />
    <link rel="manifest" href={~p"/manifest.json"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script
      defer
      phx-track-static
      type="text/javascript"
      src={~p"/assets/js/app.js"}
      nonce={assigns[:csp_nonce]}
    >
    </script>
  </head>
  <body class="min-h-screen">
    <div
      :if={assigns[:unsupported_browser]}
      id="unsupported-browser-banner"
      role="alert"
      style="position:sticky;top:0;z-index:101;padding:0.75rem 1rem;background:#fef3c7;color:#78350f;border-bottom:1px solid #f59e0b;font:600 0.9375rem/1.4 -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;"
    >
      <strong>Limited browser support.</strong>
      {GallformersWeb.BrowserSupport.banner_message()}
    </div>
    <div
      :if={Application.get_env(:gallformers, :preview_deploy)}
      class="sticky top-0 z-100 bg-danger-bg py-2 text-center text-meta font-bold text-danger"
    >
      PREVIEW — this is not production
    </div>
    <div
      :if={Gallformers.SiteSettings.banner_enabled?()}
      id="maintenance-banner"
      class="relative z-100 bg-warn-bg px-4 py-2 text-center text-meta font-medium text-warn"
    >
      {Gallformers.SiteSettings.banner_text()}
    </div>
    {@inner_content}
    {live_render(GallformersWeb.Layouts.outside_live_session(@conn), GallformersWeb.PaletteLive,
      id: "palette-live"
    )}
    {live_render(GallformersWeb.Layouts.outside_live_session(@conn), GallformersWeb.TrayLive,
      id: "tray-live"
    )}
  </body>
</html>

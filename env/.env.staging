# Staging environment configuration (Fly.io)
NODE_ENV=production
API_URL=https://gallformers-staging.fly.dev
NEXTAUTH_URL=https://gallformers-staging.fly.dev

# Fly.io paths (same as production but on staging app)
APP_PATH=/usr/src/app
DB_PATH=/data/gallformers.sqlite
DATABASE_URL=file:/data/gallformers.sqlite
BACKUP_PATH=/data/backups
LOG_PATH=/data/logs
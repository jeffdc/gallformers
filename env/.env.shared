# Shared configuration across all environments
S3_BUCKET=gallformers
AWS_REGION=us-east-1
PRIMARY_DOMAIN=gallformers.org

# Node.js configuration
NODE_VERSION=20.x
NEXT_TELEMETRY_DISABLED=1

# Backup configuration
BACKUP_LOCAL_RETENTION_DAYS=7
BACKUP_S3_RETENTION_DAYS=100
S3_BACKUP_PATH=backups/

# Auth0 configuration (base values)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=

# These will be overridden in environment-specific files 
# Local Docker environment configuration (production-like container locally)
NODE_ENV=production
API_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Docker paths (mounted volumes)
APP_PATH=/usr/src/app
DB_PATH=/data/gallformers.sqlite
DATABASE_URL=file:/data/gallformers.sqlite
BACKUP_PATH=/data/backups
LOG_PATH=/data/logs 